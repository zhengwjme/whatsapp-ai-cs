# cp .env.example .env 然后填 key。docker compose up -d --build
WHATSAPP_API_KEY=change-me            # WAHA 的 X-Api-Key，自己随便设一串

# WAHA 把消息推给谁。默认走 compose 内部服务名；bot 在 Windows 原生跑时改成：
# WAHA_HOOK_URL=http://host.docker.internal:8787/webhook
WAHA_HOOK_URL=http://bot:8787/webhook

# WAHA 的 HTTP 调用（打字 / 发送）超时，毫秒。WAHA 半死时不能让某个客户的会话一直卡住
WAHA_TIMEOUT_MS=15000

# 任意 OpenAI 兼容接口
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000                  # 单次模型调用超时（毫秒）；超时按失败处理并记日志，不会把客户一直晾着
DEBUG=0                               # 1 = 失败日志（[reply failed]）额外带调用栈，排查用
# 自建 Dify: OPENAI_BASE_URL=https://dify.example.com/v1, OPENAI_MODEL=dify-app-xxx
# 自建 MaxKB: OPENAI_BASE_URL=http://kb:8080/<应用API地址>, OPENAI_API_KEY=<MaxKB应用Key>（兼容 OpenAI 格式）
# AnythingLLM: OPENAI_BASE_URL=http://kb:3001/api/v1/openai, OPENAI_MODEL=<workspace slug>（不是模型名）
# RAGFlow:    OPENAI_BASE_URL=http://kb/api/v1/openai/<chat_id>/chat, OPENAI_MODEL=model
# 详见 docs/知识库选型.md —— 只改这 3 个变量，代码不用动
#
# 完全本地（不出网）：装原生 Ollama 后改成
#   OPENAI_BASE_URL=http://host.docker.internal:11434/v1   # bot 在容器里；原生跑用 http://localhost:11434/v1
#   OPENAI_API_KEY=ollama
#   OPENAI_MODEL=qwen3:8b

# 必须保留 [[HANDOFF]] 这句：模型答不上来时输出它，机器人才会真的转人工（标记不会发给客户）
SYSTEM_PROMPT=你是外贸客服助手，回答简洁专业，先答问题再问需求。不确定的不要编：能答的部分照常回答，答不上来的在回复末尾附上 [[HANDOFF]]，不要自己说转人工。

REPLY_GROUPS=false                    # 群聊是否也回
# 命中则暂停自动回复、转人工（子串匹配，不分大小写）。
# 只放词组，别放裸词：单独一个 human 会把 "human hair"（真人发丝）也算命中，那客户会被静默 12 小时
PAUSE_KEYWORD=人工,转人工,human agent,real person
PAUSE_HOURS=12
HISTORY_TURNS=12                      # 带最近几条消息（一问一答算 2 条）
HANDOFF_TEXT=已为您转接人工，稍后回复您。

# --- 只有 Baileys 直连模式（bot-baileys.mjs，不需要 Docker）用得上 ---
# 你的号，国家码开头不带 +，例：中国 8613800138000。填了就用配对码登录，不填则终端出二维码
WHATSAPP_PHONE=
