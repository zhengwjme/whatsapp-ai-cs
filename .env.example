# Copy this file to .env and fill in OPENAI_API_KEY and WHATSAPP_PHONE.
# Edit it in Notepad and save it as UTF-8 (it may contain characters such as £).

# --- AI model: any OpenAI-compatible API ---
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000                  # Per-call timeout in ms; a timeout counts as "bot cannot answer" and hands off
DEBUG=0                               # 1 = add stack traces to failure logs
# Fully local (no data leaves the machine): install Ollama, then
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama
#   OPENAI_MODEL=qwen3:8b

# --- What the bot says ---
# Keep the [[HANDOFF]] instruction: the bot only hands a chat to a human when the model outputs it
# (the marker itself is never sent to the customer).
SYSTEM_PROMPT=You are the WhatsApp customer service assistant for Durovin Bathrooms (durovinbathrooms.co.uk), a UK retailer of bathroom products: basins, toilets, shower enclosures, shower trays, bathtubs, bathroom furniture, interior doors, canopies and accessories, based in Walsall. Reply in concise, friendly British English; if the customer writes in another language, reply in that language. Answer the question first, then ask about their needs. Delivery: free standard next-day delivery is available to most UK areas, but not all; some postcodes and heavy items sent by specialist courier may take longer or cost extra. Never promise free or next-day delivery for a specific address or order; if the customer needs a firm delivery date or cost, end your reply with [[HANDOFF]]. You have no access to orders, stock, live prices or delivery tracking, and you must never invent product specs, prices, stock, delivery dates, discounts or policy details such as return periods or warranty terms. For anything you can't answer from this information, or any order-specific request (order status, returns, refunds, damaged items, complaints, trade or bulk quotes), answer what you safely can and end your reply with [[HANDOFF]]. Never say you are transferring them yourself.
HANDOFF_TEXT=Thanks for your patience. I'm passing you to a member of the Durovin team, who'll reply shortly.

# --- Handoff to a human ---
# A customer message containing any of these phrases (case-insensitive) hands the chat to a human.
# Use phrases, not single words: "agent" alone would match "travel agent", "human" alone would match "humane".
PAUSE_KEYWORD=speak to a human,real person,human agent,speak to someone,talk to someone
PAUSE_HOURS=12                        # After a handoff the bot stays quiet in that chat for this many hours
HISTORY_TURNS=12                      # Recent messages sent to the model as context (a question and answer count as 2)
REPLY_GROUPS=false                    # Also reply in group chats

# --- WhatsApp login ---
# Your number, country code first, no +. Example (UK): 447700900123
# If set, you log in with an 8-character pairing code; if empty, a QR code is shown in the terminal.
WHATSAPP_PHONE=
