  "mainPath": ["n_user", "n_waha", "n_hook", "n_guard", "n_llm", "n_delay", "n_send"],
  "nodes": [
    { "id": "n_user", "lane": "wa", "col": 0, "type": "external", "label": "客户消息", "sublabel": "WhatsApp 私聊", "width": 164 },
    { "id": "n_waha", "lane": "wa", "col": 1, "type": "backend", "label": "WAHA 网关", "sublabel": "NOWEB 引擎", "tag": "扫码登录态", "width": 164 },
    { "id": "n_send", "lane": "wa", "col": 5, "type": "backend", "label": "sendText 回发", "sublabel": "POST /api/sendText", "width": 164 },
    { "id": "n_hook", "lane": "bot", "col": 2, "type": "backend", "label": "Webhook 收信", "sublabel": "先 200 再处理", "width": 164 },
    { "id": "n_guard", "lane": "bot", "col": 3, "type": "security", "label": "守卫判定", "sublabel": "去重 · 暂停 · 关键词", "tag": "按消息 id 幂等", "width": 164 },
    { "id": "n_delay", "lane": "bot", "col": 5, "type": "backend", "label": "拟人延迟", "sublabel": "读 → 打字 → 发送", "tag": "封顶 6s", "width": 164 },
    { "id": "n_llm", "lane": "ai", "col": 4, "type": "cloud", "label": "LLM 生成回复", "sublabel": "OpenAI 兼容接口", "width": 164 },
    { "id": "n_store", "lane": "ai", "col": 5, "type": "database", "label": "会话历史", "sublabel": "node:sqlite", "width": 164 },
    { "id": "n_pause", "lane": "handoff", "col": 3, "type": "security", "label": "转人工暂停", "sublabel": "该会话停 N 小时", "width": 164 },
    { "id": "n_human", "lane": "handoff", "col": 5, "type": "external", "label": "人工接管", "sublabel": "你手动回复", "width": 164 }
  ],
  "edges": [
    { "id": "e_in", "from": "n_user", "to": "n_waha", "role": "main", "variant": "default" },
    { "id": "e_event", "from": "n_waha", "to": "n_hook", "label": "message 事件", "role": "main", "variant": "emphasis" },
    { "id": "e_parse", "from": "n_hook", "to": "n_guard", "label": "解析 payload", "role": "main" },
    { "id": "e_pass", "from": "n_guard", "to": "n_llm", "label": "放行", "role": "main" },
    { "id": "e_human", "from": "n_guard", "to": "n_pause", "label": "命中人工 / 已暂停", "role": "branch", "variant": "security" },
    { "id": "e_takeover", "from": "n_pause", "to": "n_human", "label": "只记录不回", "role": "branch", "variant": "security" },
    { "id": "e_draft", "from": "n_llm", "to": "n_delay", "label": "先出稿", "role": "main" },
    { "id": "e_typing", "from": "n_delay", "to": "n_send", "label": "按字数等待", "role": "main" },
    { "id": "e_ctx", "from": "n_store", "to": "n_llm", "label": "最近 12 轮上下文", "role": "branch", "variant": "dashed" },
    { "id": "e_memo", "from": "n_send", "to": "n_store", "label": "收发落库", "role": "branch", "variant": "dashed", "labelAt": [1100, 306] }
