    { "id": "handoff", "label": "转人工旁路", "variant": "exception" }
  ],
  "phases": [
    { "id": "intake", "label": "接入", "fromCol": 0, "toCol": 1 },
    { "id": "guard", "label": "判定", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "answer", "label": "生成与回发", "fromCol": 4, "toCol": 5, "variant": "dashed" }
